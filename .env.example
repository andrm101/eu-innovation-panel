# Copy this file to .env and fill in values. Never commit .env to git.
# Most sources are open and require no credentials.
# Eurostat bulk downloads: no auth required
# CORDIS CSV bulk download: no auth required
# OECD.Stat bulk export: no auth required (manual download)
# EPO PATSTAT: NOT used — Eurostat pat_ep_rtot is the chosen substitute

# Optional: if using CORDIS SPARQL endpoint (fallback to CSV if blank)
CORDIS_SPARQL_ENDPOINT=https://cordis.europa.eu/data/sparql

# Optional: logging level (DEBUG / INFO / WARNING)
LOG_LEVEL=INFO

# Dashboard
DASH_HOST=localhost
DASH_PORT=8050
DASH_DEBUG=false
